# Shared secrets used by docker-compose.yml to configure multiple services
# consistently. Copy to .env and fill in real values before `docker compose up`.
#
# nginx serves everything over HTTPS (required for camera/mic access - see
# DJANGO_SECURE_SSL_REDIRECT below), so also run this once before first start:
#   infra/nginx/generate-cert.sh <your-lan-ip-or-domain>
# It writes a self-signed cert to infra/nginx/certs/ (gitignored). Browsers
# will show a one-time warning to click through for a self-signed cert;
# that's expected without a real domain + CA-issued certificate.

# --- Postgres ---
POSTGRES_DB=fizx
POSTGRES_USER=fizx
POSTGRES_PASSWORD=change-me

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=false
# nginx always terminates TLS (see infra/nginx/nginx.conf) and forwards
# X-Forwarded-Proto, so this should stay true even for local/LAN testing -
# camera/mic access requires a secure context (https, or literally
# "localhost"), so there's no plain-HTTP deployment mode to keep this off for.
DJANGO_SECURE_SSL_REDIRECT=true
# 0 disables HSTS. Raise this only once a CA-trusted certificate is in place
# (see infra/nginx/generate-cert.sh) - with a self-signed cert, HSTS removes
# the browser's "proceed anyway" bypass entirely and locks everyone out.
DJANGO_SECURE_HSTS_SECONDS=0
# Every hostname/IP clients will use to reach this server, comma-separated.
# For LAN testing add the host's LAN IP, e.g.: localhost,127.0.0.1,192.168.1.68
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Same hosts as above, but as full https origins (scheme + host, no path):
# https://localhost,https://192.168.1.68
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
CORS_ALLOWED_ORIGINS=https://localhost
FRONTEND_URL=https://localhost

# --- WhatsApp OTP (separate local service - see /whatsapp-otp) ---
# whatsapp-otp runs standalone on the host, not as a container on this
# compose network, so the backend reaches it via host.docker.internal - same
# pattern as LIVEKIT_HTTP_URL below. Must match the API_KEY value in
# whatsapp-otp/.env exactly (generate both with: openssl rand -hex 32).
WHATSAPP_OTP_URL=http://host.docker.internal:3210
WHATSAPP_OTP_API_KEY=change-me

# --- LiveKit (shared by backend, livekit-server, and coturn) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_prod_min_32_chars
# The address LiveKit advertises in ICE candidates - must be reachable by
# every client. Set this to the host's LAN IP for local/LAN testing (e.g.
# 192.168.1.68), or its public IP (with UDP 50000-50100 + TCP 7881 forwarded)
# for a real internet-facing deployment. Leaving it unset lets LiveKit guess,
# which on a Docker host is usually wrong and causes intermittent
# disconnects once ICE renegotiates.
LIVEKIT_NODE_IP=

# --- coturn (TURN relay) ---
TURN_REALM=fizx.local
TURN_SHARED_SECRET=change-me-turn-shared-secret
# Same address as LIVEKIT_NODE_IP above.
TURN_PUBLIC_IP=127.0.0.1
# Only set this on a cloud VM (AWS/GCP/etc) where the instance's network
# interface has a private IP and the provider NATs it to TURN_PUBLIC_IP -
# e.g. an AWS EC2 box typically only sees 172.31.x.x locally. Without this,
# coturn announces the unreachable private IP to clients and any call that
# can't connect peer-to-peer directly (different networks, restrictive
# NATs - which is most real-world calls) fails outright. Leave unset on a
# bare LAN/VPS host where the public-facing IP is the real interface IP.
TURN_RELAY_IP=

# --- Stripe ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# --- OpenAI (AI assistant) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MinIO (self-hosted S3-compatible storage for recordings) ---
AWS_STORAGE_BUCKET_NAME=fizx-recordings
AWS_ACCESS_KEY_ID=fizx-minio
AWS_SECRET_ACCESS_KEY=change-me-minio-secret
# Must be this machine's LAN IP, not host.docker.internal/localhost - see
# the comment in docker-compose.yml for why.
AWS_S3_ENDPOINT_URL=http://YOUR_LAN_IP:9000
AWS_S3_REGION_NAME=us-east-1

# --- Frontend ---
# Leave these unset (default) so the frontend derives API/WebSocket URLs from
# whatever host/origin the browser actually used to load the page - this is
# what makes the same build work from localhost, a LAN IP, or a real domain
# without rebuilding. Only set them if the API or LiveKit truly live on a
# different origin than the web app itself.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_LIVEKIT_URL=
