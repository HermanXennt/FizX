# Shared secret the backend must send as the X-API-Key header on
# /api/send-otp and /api/verify-otp. Generate with: openssl rand -hex 32
# This service controls a live, linked WhatsApp session - anyone with this
# key can send messages as that number and read OTP verification attempts,
# so treat it the same as any other credential (never commit the real value).
API_KEY=change-me

PORT=3210
